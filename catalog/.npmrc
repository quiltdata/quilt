# MUI v4, jsoneditor-react, react-swipeable-views and react-input-autosize cap
# their React peer at 17 but run on 18; npm overrides can't reach peer ranges.
# Side effect: peers aren't auto-installed, so jsoneditor and xstate are listed
# directly. The `@types/react` csstype override keeps MUI v4's JSS style types
# assignable. Drop all three with the MUI v5 move.
legacy-peer-deps=true
