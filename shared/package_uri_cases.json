{
  "valid": [
    {
      "name": "package without selector or path",
      "uri": "quilt+s3://bucket-name#package=quilt/test",
      "value": {
        "bucket": "bucket-name",
        "name": "quilt/test"
      }
    },
    {
      "name": "tag selector",
      "uri": "quilt+s3://bucket-name#package=quilt/test:latest",
